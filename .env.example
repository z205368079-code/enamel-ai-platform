# Gateway
NODE_ENV=development
GATEWAY_PORT=3000

# PostgreSQL (local development placeholders only)
POSTGRES_DB=enamel_ai
POSTGRES_USER=enamel_ai
POSTGRES_PASSWORD=change_me_for_local_dev
DATABASE_URL=postgresql://enamel_ai:change_me_for_local_dev@postgres:5432/enamel_ai

# Chatwoot Phase 1 (leave blank until a self-hosted or test instance is available)
CHATWOOT_BASE_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_TOKEN=
CHATWOOT_REQUEST_TIMEOUT_MS=5000

# MaxKB Phase 2 (application API key; keep real values out of this file)
MAXKB_BASE_URL=
MAXKB_API_KEY=
MAXKB_APP_ID=
# Optional override for non-default MaxKB CHAT_PATH deployments.
MAXKB_CHAT_COMPLETIONS_URL=
MAXKB_TIMEOUT_MS=10000
MAXKB_MAX_RETRIES=1
MAXKB_RETRY_DELAY_MS=200

# Optional DeepSeek fallback. Used only after MaxKB returns NO_ANSWER.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=10000

# Phase 3 human handoff demo rules (not production policy)
AI_FAILURE_HANDOFF_THRESHOLD=2
HIGH_RISK_KEYWORDS=赔偿,投诉,法律,起诉,人身伤害,严重质量问题
INTERNAL_API_TOKEN=change-me-for-local-demo

# Dashboard (Operations Dashboard BFF)
DASHBOARD_PORT=3001
GATEWAY_BASE_URL=http://127.0.0.1:3000
