{
  "name": "enamel-ai-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Interview PoC for an enamel cookware enterprise AI integration platform.",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace @enamel-ai/gateway",
    "dev:dashboard": "npm run dev --workspace @enamel-ai/dashboard",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint --workspaces --if-present",
    "migrate": "npm run migrate --workspace @enamel-ai/gateway",
    "start": "npm run start --workspace @enamel-ai/gateway",
    "start:dashboard": "npm run start --workspace @enamel-ai/dashboard",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.0.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
